<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\openkogama-photon\openkogama-photon.csproj" />
    <ProjectReference Include="..\openkogama-mods\patches\OpenKogama.Mods.Patches.csproj" />
    <ProjectReference Include="api\openkogama-api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="api\**;examples\**;browser\**;tests\**" />
    <None Remove="api\**;examples\**;browser\**" />
    <Content Include="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenKogama</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>

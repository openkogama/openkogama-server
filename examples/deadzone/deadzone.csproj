<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\api\openkogama-api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="deadzone.kgmap" LogicalName="deadzone.kgmap" />
    <EmbeddedResource Include="zombie-skin.json" LogicalName="zombie-skin.json" />
    <EmbeddedResource Include="test-icon.png" LogicalName="test-icon.png" />
    <EmbeddedResource Include="nights.json" LogicalName="nights.json" />
    <EmbeddedResource Include="*.kgavatar" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>deadzone</AssemblyName>
    <RootNamespace>Deadzone</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CopyToServer" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\..\bin\$(Configuration)\net10.0\plugins" />
  </Target>

</Project>
